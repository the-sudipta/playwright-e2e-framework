{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript end-to-end framework for Sauce Demo with an API layer for Restful Booker",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . && prettier --check \"**/*.ts\" && tsc --noEmit -p .",
    "format": "prettier --write \"**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-sudipta/playwright-e2e-framework.git"
  },
  "author": "Sudipta Kumar Das",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/the-sudipta/playwright-e2e-framework/issues"
  },
  "homepage": "https://github.com/the-sudipta/playwright-e2e-framework#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true
}
